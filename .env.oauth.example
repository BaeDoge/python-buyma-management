# BUYMA OAuth 토큰을 새로 발급할 때만 사용합니다.
# 이 파일을 .env.oauth로 복사하세요. 평소 가격 비교/변경에는 필요하지 않습니다.

NGROK_AUTHTOKEN=
BUYMA_CLIENT_ID=
BUYMA_CLIENT_SECRET=
# BUYMA Partners에 등록한 Redirect URI와 정확히 같아야 합니다.
BUYMA_REDIRECT_URI=https://YOUR-NGROK-HOST.ngrok-free.app/callback
BUYMA_API_BASE_URL=https://personal-shopper-api.buyma.com

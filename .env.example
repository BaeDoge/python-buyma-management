# ngrok tunnel authentication
NGROK_AUTHTOKEN=

# BUYMA Personal Shopper API OAuth
BUYMA_CLIENT_ID=
BUYMA_CLIENT_SECRET=
# Must exactly match BUYMA Partners Callback Redirect URL, including /callback
BUYMA_REDIRECT_URI=https://YOUR-NGROK-HOST.ngrok-free.app/callback
BUYMA_API_BASE_URL=https://personal-shopper-api.buyma.com

# Optional: for payload_migration.py only; keep blank if not used
BUYMA_LOGIN_ID=
BUYMA_LOGIN_PASSWORD=

# BUYMA 할인/타임세일 상품 가격 변경 허용 여부 (기본 false)
# false: 공개 표시 가격과 실제 商品価格가 다르면 해당 상품을 건너뜀
# true: 전체 일반 상품 조회 후 할인/타임세일 후보를 별도로 보여주고 확인 후 변경
BUYMA_ALLOW_TIMESALE_PRICE_UPDATE=false

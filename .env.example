# BUYMA 판매자 로그인 (가격 변경 시 필요)
BUYMA_LOGIN_ID=
BUYMA_LOGIN_PASSWORD=

# 할인/타임세일 상품 가격 변경 허용 여부
# false: 화면 표시 가격과 판매자 실제 상품 가격이 다르면 변경하지 않습니다.
# true: 판매자 실제 상품 가격으로 다시 계산해 변경 후보에 포함합니다.
BUYMA_ALLOW_TIMESALE_PRICE_UPDATE=false

# 예약 실행기(BUYMA-Scheduler.exe) 설정 - PC 현지 시간 기준
BUYMA_SCHEDULE_TIMES=06:00,12:00,18:00,00:00
BUYMA_SCHEDULE_PRICE_DELTA=10
BUYMA_SCHEDULE_MAX_CHANGE=50
BUYMA_SCHEDULE_HEADLESS=true
